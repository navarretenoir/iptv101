<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>IPTV101</RootNamespace>
    <AssemblyName>IPTV101</AssemblyName>
    <ApplicationIcon>..\..\iconos\iptv101.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Product>IPTV 101</Product>
    <AssemblyTitle>IPTV 101</AssemblyTitle>
    <Description>Reproductor IPTV con listas propias e interfaces de distintas épocas de Windows</Description>
    <Company>Javiera Navarrete</Company>
    <Authors>Javiera Navarrete</Authors>
    <Copyright>© 2026 Javiera Navarrete</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\iconos\iptv101.ico" Link="Assets\IPTV101.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Motor de video (libmpv). IPTV 101 no trae listas de canales precargadas: el usuario importa
         las suyas desde el diálogo "Importar listas" (archivo .m3u/.m3u8 local o URL remota). -->
    <Content Include="..\..\runtime\libmpv-2.dll" Condition="Exists('..\..\runtime\libmpv-2.dll')" CopyToOutputDirectory="PreserveNewest" Link="libmpv-2.dll" />
  </ItemGroup>

</Project>
