<Window x:Class="IPTV101.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Width="640" Height="360">

    <Window.Resources>
        <SolidColorBrush x:Key="OsdBack" Color="#E6151518" />
        <SolidColorBrush x:Key="OsdStroke" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="OsdText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="OsdSub" Color="#C8FFFFFF" />
        <Style x:Key="OsdButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{StaticResource OsdText}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="21" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Layer">
        <!-- Canal actual -->
        <Border x:Name="Banner" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Padding="14,12,18,12"
                CornerRadius="12" Background="{StaticResource OsdBack}" BorderBrush="{StaticResource OsdStroke}" BorderThickness="1"
                MaxWidth="560" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerNumber" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Light"
                           Foreground="{StaticResource OsdSub}" VerticalAlignment="Center" Margin="2,0,14,0" />
                <Grid Grid.Column="1" Width="52" Height="52" Margin="0,0,14,0">
                    <Border x:Name="BannerBadge" CornerRadius="10">
                        <TextBlock x:Name="BannerInitials" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="BannerLogoBox" CornerRadius="10" Background="#FFF7F7F8" Padding="4" Visibility="Collapsed">
                        <Image x:Name="BannerLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerName" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource OsdText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BannerGroup" FontSize="13" Foreground="{StaticResource OsdSub}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse x:Name="BannerDot" Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center" Fill="#FF9E9E9E" />
                        <TextBlock x:Name="BannerStatus" FontSize="13" Foreground="{StaticResource OsdText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Indicador breve (volumen, número, aspecto) -->
        <Border x:Name="Chip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Padding="18,10"
                CornerRadius="12" Background="{StaticResource OsdBack}" BorderBrush="{StaticResource OsdStroke}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ChipIcon" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource OsdText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="ChipText" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource OsdText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Mensaje central (sin canal, canal caído) -->
        <Border x:Name="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MaxWidth="520"
                CornerRadius="14" Background="{StaticResource OsdBack}" BorderBrush="{StaticResource OsdStroke}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="CenterIcon" FontFamily="{StaticResource IconFont}" FontSize="34" HorizontalAlignment="Center"
                           Foreground="{StaticResource OsdText}" Margin="0,0,0,12" />
                <TextBlock x:Name="CenterTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource OsdText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="CenterDetail" FontSize="14" Foreground="{StaticResource OsdSub}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="CenterHint" FontSize="12" Foreground="{StaticResource OsdSub}" Opacity="0.85" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Información técnica -->
        <Border x:Name="Stats" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,20,20,96" Padding="14,10"
                CornerRadius="10" Background="{StaticResource OsdBack}" BorderBrush="{StaticResource OsdStroke}" BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="StatsText" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource OsdText}" />
        </Border>

        <!-- Controles en pantalla completa -->
        <Border x:Name="FsBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="8,6"
                CornerRadius="26" Background="{StaticResource OsdBack}" BorderBrush="{StaticResource OsdStroke}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FsGuide" Style="{StaticResource OsdButton}" Content="&#xE8FD;" ToolTip="Canales (Menú)" />
                <Rectangle Width="1" Height="22" Fill="#33FFFFFF" Margin="6,0" />
                <Button x:Name="FsPrev" Style="{StaticResource OsdButton}" Content="&#xE892;" ToolTip="Canal anterior" />
                <Button x:Name="FsPlay" Style="{StaticResource OsdButton}" Content="&#xE768;" ToolTip="Reproducir o pausar" />
                <Button x:Name="FsNext" Style="{StaticResource OsdButton}" Content="&#xE893;" ToolTip="Canal siguiente" />
                <Rectangle Width="1" Height="22" Fill="#33FFFFFF" Margin="6,0" />
                <Button x:Name="FsMute" Style="{StaticResource OsdButton}" Content="&#xE767;" ToolTip="Silenciar" />
                <Slider x:Name="FsVolume" Width="110" Minimum="0" Maximum="130" VerticalAlignment="Center" Margin="2,0,8,0"
                        IsMoveToPointEnabled="True" Focusable="False" />
                <Button x:Name="FsAspect" Style="{StaticResource OsdButton}" Content="&#xE799;" ToolTip="Relación de aspecto" />
                <Button x:Name="FsExit" Style="{StaticResource OsdButton}" Content="&#xE73F;" ToolTip="Salir de pantalla completa (Esc)" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
