<Window x:Class="IPTV101.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:player="clr-namespace:IPTV101.Player"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IPTV 101" Width="1120" Height="680" MinWidth="760" MinHeight="460"
        FontFamily="{DynamicResource UiFont}"
        Icon="pack://application:,,,/Assets/IPTV101.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0"
                             ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título propia: se vuelve a dibujar por completo en cada skin (color, tipografía,
             botones), para que la ventana luzca de verdad como la época elegida, no solo sus controles. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Assets/IPTV101.ico" Width="18" Height="18" Margin="8,0,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="IPTV 101" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                       Foreground="{DynamicResource TitleBarForegroundBrush}" IsHitTestVisible="False" />
            <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{DynamicResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar"
                        AutomationProperties.Name="Minimizar" Click="CaptionMin_Click" />
                <Button x:Name="MaxButton" Style="{DynamicResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar"
                        AutomationProperties.Name="Maximizar o restaurar" Click="CaptionMax_Click" />
                <Button x:Name="CloseCaptionButton" Style="{DynamicResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar" Click="CaptionClose_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Root" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="336" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de canales -->
            <Grid x:Name="Sidebar" Grid.Column="0" Margin="14,6,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,0,10" LastChildFill="False">
                    <TextBlock Text="IPTV 101" DockPanel.Dock="Left" Margin="0,0,0,1" VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE712;"
                            ToolTip="Más opciones" AutomationProperties.Name="Más opciones" Click="MoreButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <ContextMenu.Resources>
                                    <!-- La fuente de iconos va SOLO en el glifo de MenuItem.Icon; el texto de cada
                                         MenuItem (Header) siempre usa la fuente normal de la interfaz, nunca la de
                                         iconos, sin depender de ningun valor heredado o ambiguo del tema. -->
                                    <Style TargetType="MenuItem">
                                        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                                        <Setter Property="FontSize" Value="14" />
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Importar o gestionar listas…" Click="ManageLists_Click" FontWeight="SemiBold">
                                    <MenuItem.Icon><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8B5;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Actualizar listas desde sus fuentes" Click="UpdateLists_Click">
                                    <MenuItem.Icon><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE895;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Información técnica" InputGestureText="I" Click="ToggleStats_Click">
                                    <MenuItem.Icon><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE9D9;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Tema">
                                    <MenuItem.Icon><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE790;" /></MenuItem.Icon>
                                    <MenuItem x:Name="ThemeSystem" Header="Según Windows" IsCheckable="True" Click="Theme_Click" Tag="Sistema" />
                                    <MenuItem x:Name="ThemeLight" Header="Claro" IsCheckable="True" Click="Theme_Click" Tag="Claro" />
                                    <MenuItem x:Name="ThemeDark" Header="Oscuro" IsCheckable="True" Click="Theme_Click" Tag="Oscuro" />
                                </MenuItem>
                                <MenuItem Header="Apariencia">
                                    <MenuItem.Icon><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE771;" /></MenuItem.Icon>
                                    <MenuItem x:Name="Skin95" Header="Windows 95" IsCheckable="True" Click="Skin_Click" Tag="Win95" />
                                    <MenuItem x:Name="Skin98" Header="Windows 98" IsCheckable="True" Click="Skin_Click" Tag="Win98" />
                                    <MenuItem x:Name="SkinMe" Header="Windows Me" IsCheckable="True" Click="Skin_Click" Tag="WinMe" />
                                    <MenuItem x:Name="Skin2000" Header="Windows 2000" IsCheckable="True" Click="Skin_Click" Tag="Win2000" />
                                    <MenuItem x:Name="SkinXP" Header="Windows XP" IsCheckable="True" Click="Skin_Click" Tag="WinXP" />
                                    <MenuItem x:Name="Skin7" Header="Windows 7" IsCheckable="True" Click="Skin_Click" Tag="Win7" />
                                    <MenuItem x:Name="Skin8" Header="Windows 8" IsCheckable="True" Click="Skin_Click" Tag="Win8" />
                                    <MenuItem x:Name="Skin1011" Header="Windows 10 / 11" IsCheckable="True" Click="Skin_Click" Tag="Win1011" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Atajos y acerca de IPTV 101" Click="About_Click">
                                    <MenuItem.Icon><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE946;" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>

                <!-- Búsqueda -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" Padding="34,6,10,6" FontSize="14" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Buscar canal" TextChanged="SearchBox_TextChanged" />
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE721;" FontSize="14" Margin="12,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="SearchHint" Text="Buscar canal o número" FontSize="14" Margin="35,0,0,1"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                </Grid>

                <WrapPanel x:Name="ListPills" Grid.Row="2" Margin="0,0,0,4" KeyboardNavigation.DirectionalNavigation="Cycle" />

                <ComboBox x:Name="GroupBox" Grid.Row="3" Margin="0,0,0,10" HorizontalAlignment="Stretch" FontSize="13"
                          AutomationProperties.Name="Grupo o país" SelectionChanged="GroupBox_SelectionChanged" />

                <!-- Lista de canales y estado vacío ocupan la misma celda: solo uno de los dos se ve. -->
                <Grid Grid.Row="4">
                    <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{DynamicResource ChannelRow}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1,2" VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             IsTextSearchEnabled="False" AutomationProperties.Name="Canales"
                             MouseDoubleClick="ChannelList_MouseDoubleClick" MouseLeftButtonUp="ChannelList_MouseLeftButtonUp">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ver ahora" Click="CtxPlay_Click" />
                                <MenuItem x:Name="CtxFav" Header="Agregar a favoritos" Click="CtxFav_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NumberText, Mode=OneTime}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,10,0" FontSize="12" FontFamily="{DynamicResource UiFont}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" HorizontalAlignment="Left"
                                            Background="{Binding BadgeBrush, Mode=OneTime}">
                                        <TextBlock Text="{Binding Initials, Mode=OneTime}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" HorizontalAlignment="Left"
                                            Background="#FFF7F7F8" Padding="3"
                                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,6,0">
                                        <TextBlock x:Name="name" Text="{Binding Name, Mode=OneTime}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Group, Mode=OneTime}" Style="{DynamicResource Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE9E9;" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AppAccentTextBrush}"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE735;" FontSize="13"
                                                   Foreground="{DynamicResource AppCautionBrush}"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="name" Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Estado vacío: se ve cuando IPTV 101 todavía no tiene ninguna lista importada. -->
                    <Border x:Name="EmptyState" Visibility="Collapsed" CornerRadius="10" Padding="22,26"
                            Background="{DynamicResource AppSubtleSecondaryBrush}"
                            BorderBrush="{DynamicResource AppStrokeDefaultBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8B5;" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppAccentTextBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Todavía no tienes listas" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" Style="{DynamicResource Caption}"
                                       Text="IPTV 101 se instala sin canales. Importa un archivo .m3u/.m3u8 propio o pega la URL de una lista para empezar a ver." />
                            <Button Content="Importar mi primera lista…" Style="{DynamicResource AppButton}" HorizontalAlignment="Center" Click="ManageLists_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="FooterText" Grid.Row="5" Style="{DynamicResource Caption}" Margin="4,8,0,0" Text="Cargando canales…" />
            </Grid>

            <!-- Video y controles -->
            <Grid x:Name="VideoColumn" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="VideoFrame" Grid.Row="0" Margin="6,8,12,0" Background="Black" CornerRadius="8">
                    <player:VideoHost x:Name="Host" />
                </Border>

                <Grid x:Name="ControlBar" Grid.Row="1" Height="72" Margin="6,0,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Border x:Name="NowBadge" CornerRadius="8" Background="{DynamicResource AppSubtleSecondaryBrush}">
                                <TextBlock x:Name="NowInitials" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="NowLogoBox" CornerRadius="8" Background="#FFF7F7F8" Padding="3" Visibility="Collapsed">
                                <Image x:Name="NowLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NowName" Text="Sin canal" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="NowStatus" Text="Elige un canal" Style="{DynamicResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{DynamicResource IconButton}" Content="&#xE892;" ToolTip="Canal anterior (RePág)"
                                AutomationProperties.Name="Canal anterior" Click="Prev_Click" />
                        <Button x:Name="StopButton" Style="{DynamicResource IconButton}" Content="&#xE71A;" ToolTip="Detener"
                                AutomationProperties.Name="Detener" Click="Stop_Click" Margin="2,0" />
                        <Button x:Name="PlayButton" Style="{DynamicResource PrimaryRoundButton}" Content="&#xE768;" ToolTip="Reproducir o pausar (Espacio)"
                                AutomationProperties.Name="Reproducir o pausar" Click="PlayPause_Click" Margin="6,0" />
                        <Button x:Name="RetryButton" Style="{DynamicResource IconButton}" Content="&#xE72C;" ToolTip="Reintentar"
                                AutomationProperties.Name="Reintentar" Click="Retry_Click" Margin="2,0" />
                        <Button x:Name="NextButton" Style="{DynamicResource IconButton}" Content="&#xE893;" ToolTip="Canal siguiente (AvPág)"
                                AutomationProperties.Name="Canal siguiente" Click="Next_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="FavButton" Style="{DynamicResource IconButton}" Content="&#xE734;" ToolTip="Favorito (*)"
                                AutomationProperties.Name="Favorito" Click="Fav_Click" Margin="14,0,0,0" Padding="3,0,0,0" />
                        <Button x:Name="AspectButton" Style="{DynamicResource IconButton}" Width="Auto" Padding="10,0" ToolTip="Relación de aspecto (A)"
                                AutomationProperties.Name="Relación de aspecto" Click="Aspect_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE799;" VerticalAlignment="Center" />
                                <TextBlock x:Name="AspectText" FontFamily="{DynamicResource UiFont}" FontSize="12" Text="Auto"
                                           Margin="6,0,0,1" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MuteButton" Style="{DynamicResource IconButton}" Content="&#xE767;" ToolTip="Silenciar (M)"
                                AutomationProperties.Name="Silenciar" Click="Mute_Click" />
                        <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="130" VerticalAlignment="Center" Margin="2,0,6,0"
                                IsMoveToPointEnabled="True" SmallChange="5" LargeChange="10" Focusable="False"
                                AutomationProperties.Name="Volumen" ValueChanged="VolumeSlider_ValueChanged" />
                        <Button x:Name="FsButton" Style="{DynamicResource IconButton}" Content="&#xE740;" ToolTip="Pantalla completa (F11)"
                                AutomationProperties.Name="Pantalla completa" Click="Fullscreen_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
