<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Marcador: le permite a SkinManager saber que el diccionario en la posicion 0 es un skin
         propio (y por lo tanto reemplazable) y no algo puesto por otra parte del sistema. -->
    <SolidColorBrush x:Key="__SkinMarker" Color="Transparent" />


    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Tahoma, Segoe UI</FontFamily>

    <CornerRadius x:Key="FocusRingRadius">8</CornerRadius>
    <CornerRadius x:Key="FocusRingInnerRadius">6</CornerRadius>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="AppSubtleSecondaryBrush" Color="#FFE9E4D8" />
    <SolidColorBrush x:Key="AppSubtleTertiaryBrush" Color="#FFDCD5C0" />
    <SolidColorBrush x:Key="AppStrokeDefaultBrush" Color="#FF8FA6C0" />
    <SolidColorBrush x:Key="AppStrokeSecondaryBrush" Color="#FF5F7E9E" />
    <SolidColorBrush x:Key="AppControlFillDefaultBrush" Color="#FFECE9D8" />
    <SolidColorBrush x:Key="AppControlFillSecondaryBrush" Color="#FFF5F2E6" />
    <SolidColorBrush x:Key="AppControlFillTertiaryBrush" Color="#FFD9D3BE" />
    <SolidColorBrush x:Key="AppAccentDefaultBrush" Color="#FF2A66B8" />
    <SolidColorBrush x:Key="AppAccentSecondaryBrush" Color="#FF4C84D4" />
    <SolidColorBrush x:Key="AppAccentTertiaryBrush" Color="#FF17447E" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF18539C" />
    <SolidColorBrush x:Key="AppTextOnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppTextOnAccentSecondaryBrush" Color="#FFEAF2FC" />
    <SolidColorBrush x:Key="AppFocusOuterBrush" Color="#FF2A66B8" />
    <SolidColorBrush x:Key="AppFocusInnerBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppCautionBrush" Color="#FFCB8A1E" />
    <SolidColorBrush x:Key="AppCriticalBrush" Color="#FFC0392B" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFF5F2E6" />
    <SolidColorBrush x:Key="AppSolidBackgroundBase" Color="#FFECE9D8" />
    <SolidColorBrush x:Key="AppSolidBackgroundSecondary" Color="#FFF5F2E6" />

    <!-- Ventana y barra de titulo -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFECE9D8" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FF0A58A3" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#FFD03030" />

    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0A58A3" Offset="0" />
        <GradientStop Color="#FF3C92DC" Offset="0.8" />
        <GradientStop Color="#FF6DB2EE" Offset="1" />
    </LinearGradientBrush>


    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botones: estilo "Luna" (gradiente, esquinas redondeadas). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource AppStrokeDefaultBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFEFF8FE" Offset="0" />
                                    <GradientStop Color="#FFBFDCF9" Offset="0.55" />
                                    <GradientStop Color="#FF9FC8EE" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="hoverFx" CornerRadius="5" Background="White" Opacity="0" />
                        <Border x:Name="pressFx" CornerRadius="5" Background="Black" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hoverFx" Property="Opacity" Value="0.18" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pressFx" Property="Opacity" Value="0.22" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryRoundButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="12" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource AppControlFillDefaultBrush}"
                            BorderBrush="{DynamicResource AppStrokeDefaultBrush}" BorderThickness="1">
                        <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AppSubtleTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AppAccentDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChannelRow" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource RowFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource AppAccentDefaultBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                            <Setter TargetName="pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton generico (CTA / Cerrar / filas de dialogo): se referencia explicitamente con
         Style="{DynamicResource AppButton}" porque, con ThemeMode=System activo, un Style sin
         x:Key (implicito) no alcanza a reemplazar la plantilla nativa de Button por control. -->
    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource AppStrokeDefaultBrush}">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Anillos de foco (teclado / control remoto). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{DynamicResource FocusRingRadius}" BorderThickness="2"
                            BorderBrush="{DynamicResource AppFocusOuterBrush}">
                        <Border CornerRadius="{DynamicResource FocusRingInnerRadius}" BorderThickness="1" BorderBrush="{DynamicResource AppFocusInnerBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{DynamicResource FocusRingInnerRadius}" BorderThickness="2" BorderBrush="{DynamicResource AppFocusOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}" />

</ResourceDictionary>
