<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Marcador: le permite a SkinManager saber que el diccionario en la posicion 0 es un skin
         propio (y por lo tanto reemplazable) y no algo puesto por otra parte del sistema. -->
    <SolidColorBrush x:Key="__SkinMarker" Color="Transparent" />


    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>

    <CornerRadius x:Key="FocusRingRadius">10</CornerRadius>
    <CornerRadius x:Key="FocusRingInnerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFCBD6E6" />
    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#FF95A4BC" />
    <SolidColorBrush x:Key="AppSubtleSecondaryBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AppSubtleTertiaryBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AppStrokeDefaultBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="AppStrokeSecondaryBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="AppControlFillDefaultBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppControlFillSecondaryBrush" Color="#2DFFFFFF" />
    <SolidColorBrush x:Key="AppControlFillTertiaryBrush" Color="#3BFFFFFF" />
    <SolidColorBrush x:Key="AppAccentDefaultBrush" Color="#FF3D8FD6" />
    <SolidColorBrush x:Key="AppAccentSecondaryBrush" Color="#FF5AA6E6" />
    <SolidColorBrush x:Key="AppAccentTertiaryBrush" Color="#FF2A6CA8" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF8FCBFF" />
    <SolidColorBrush x:Key="AppTextOnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppTextOnAccentSecondaryBrush" Color="#FFEAF4FF" />
    <SolidColorBrush x:Key="AppFocusOuterBrush" Color="#FF8FCBFF" />
    <SolidColorBrush x:Key="AppFocusInnerBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppCautionBrush" Color="#FFE8B23C" />
    <SolidColorBrush x:Key="AppCriticalBrush" Color="#FFE05A5A" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="AppSolidBackgroundBase" Color="#FF1E3A5C" />
    <SolidColorBrush x:Key="AppSolidBackgroundSecondary" Color="#FF27496E" />

    <!-- Ventana y barra de titulo -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E3A5C" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#552B4F7A" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#FFD35050" />

    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E62B4F7A" Offset="0" />
        <GradientStop Color="#E61A2E4D" Offset="1" />
    </LinearGradientBrush>


    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botones: estilo "Aero" (brillo superior, vidrio translucido). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" BorderBrush="#4CFFFFFF" Background="{DynamicResource AppControlFillDefaultBrush}">
                            <Border CornerRadius="8" Margin="1,1,1,0" VerticalAlignment="Top" Height="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Border x:Name="hoverFx" CornerRadius="8" Background="{DynamicResource AppAccentDefaultBrush}" Opacity="0" />
                        <Border x:Name="pressFx" CornerRadius="8" Background="Black" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hoverFx" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pressFx" Property="Opacity" Value="0.22" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryRoundButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="bg" Fill="{DynamicResource AppAccentDefaultBrush}" />
                        <Ellipse Margin="2,2,2,22">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#70FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{DynamicResource AppAccentSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{DynamicResource AppAccentTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource AppSubtleSecondaryBrush}"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AppSubtleTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AppAccentDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChannelRow" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource RowFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource AppAccentDefaultBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                            <Setter TargetName="pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton generico (CTA / Cerrar / filas de dialogo): se referencia explicitamente con
         Style="{DynamicResource AppButton}" porque, con ThemeMode=System activo, un Style sin
         x:Key (implicito) no alcanza a reemplazar la plantilla nativa de Button por control. -->
    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#00000000" />
                        </Border.BorderBrush>
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Anillos de foco (teclado / control remoto). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{DynamicResource FocusRingRadius}" BorderThickness="2"
                            BorderBrush="{DynamicResource AppFocusOuterBrush}">
                        <Border CornerRadius="{DynamicResource FocusRingInnerRadius}" BorderThickness="1" BorderBrush="{DynamicResource AppFocusInnerBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{DynamicResource FocusRingInnerRadius}" BorderThickness="2" BorderBrush="{DynamicResource AppFocusOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}" />

</ResourceDictionary>
