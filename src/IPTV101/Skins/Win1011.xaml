<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Marcador: le permite a SkinManager saber que el diccionario en la posicion 0 es un skin
         propio (y por lo tanto reemplazable) y no algo puesto por otra parte del sistema. -->
    <SolidColorBrush x:Key="__SkinMarker" Color="Transparent" />


    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Semibold, Segoe UI</FontFamily>

    <CornerRadius x:Key="FocusRingRadius">9</CornerRadius>
    <CornerRadius x:Key="FocusRingInnerRadius">7</CornerRadius>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="AppSubtleSecondaryBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="AppSubtleTertiaryBrush" Color="#FFE4E4E4" />
    <SolidColorBrush x:Key="AppStrokeDefaultBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="AppStrokeSecondaryBrush" Color="#FFC6C6C6" />
    <SolidColorBrush x:Key="AppControlFillDefaultBrush" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="AppControlFillSecondaryBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="AppControlFillTertiaryBrush" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="AppAccentDefaultBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AppAccentSecondaryBrush" Color="#FF1975C8" />
    <SolidColorBrush x:Key="AppAccentTertiaryBrush" Color="#FF0052A0" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AppTextOnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppTextOnAccentSecondaryBrush" Color="#FFEAF2FC" />
    <SolidColorBrush x:Key="AppFocusOuterBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AppFocusInnerBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppCautionBrush" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="AppCriticalBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppSolidBackgroundBase" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="AppSolidBackgroundSecondary" Color="#FFF9F9F9" />

    <!-- Ventana y barra de titulo -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#FFE81123" />

    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFF3F3F3" />


    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="0">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botones: estilo Fluent moderno (plano/suave, como la base original de la app). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppSubtleTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryRoundButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{DynamicResource AppAccentSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{DynamicResource AppAccentTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource AppSubtleSecondaryBrush}"
                            BorderBrush="{DynamicResource AppStrokeDefaultBrush}" BorderThickness="1">
                        <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AppSubtleTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AppAccentDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChannelRow" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource RowFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource AppAccentDefaultBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppSubtleSecondaryBrush}" />
                            <Setter TargetName="pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton generico (CTA / Cerrar / filas de dialogo): se referencia explicitamente con
         Style="{DynamicResource AppButton}" porque, con ThemeMode=System activo, un Style sin
         x:Key (implicito) no alcanza a reemplazar la plantilla nativa de Button por control. -->
    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentDefaultBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#00000000" />
                        </Border.BorderBrush>
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Anillos de foco (teclado / control remoto). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{DynamicResource FocusRingRadius}" BorderThickness="2"
                            BorderBrush="{DynamicResource AppFocusOuterBrush}">
                        <Border CornerRadius="{DynamicResource FocusRingInnerRadius}" BorderThickness="1" BorderBrush="{DynamicResource AppFocusInnerBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="{DynamicResource FocusRingInnerRadius}" BorderThickness="2" BorderBrush="{DynamicResource AppFocusOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}" />

</ResourceDictionary>
